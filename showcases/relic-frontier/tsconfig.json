{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "paths": {
      "@three-game-kit/core": ["../../packages/core/src/index.ts"],
      "@three-game-kit/client": ["../../packages/client/src/index.ts"],
      "@three-game-kit/client/advanced": ["../../packages/client/src/advanced.ts"],
      "@three-game-kit/client/asset-manager": ["../../packages/client/src/asset-manager.ts"],
      "@three-game-kit/client/audio": ["../../packages/client/src/audio.ts"],
      "@three-game-kit/client/camera": ["../../packages/client/src/camera.ts"],
      "@three-game-kit/client/character-controller": ["../../packages/client/src/character-controller.ts"],
      "@three-game-kit/client/collision": ["../../packages/client/src/collision.ts"],
      "@three-game-kit/client/gameplay": ["../../packages/client/src/gameplay.ts"],
      "@three-game-kit/client/genre": ["../../packages/client/src/genre.ts"],
      "@three-game-kit/client/input": ["../../packages/client/src/input.ts"],
      "@three-game-kit/client/rendering": ["../../packages/client/src/rendering.ts"],
      "@three-game-kit/client/vfx": ["../../packages/client/src/vfx.ts"],
