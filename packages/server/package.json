{
  "name": "@three-game-kit/server",
  "version": "0.1.0",
  "description": "Authoritative multiplayer server, collision, and networking utilities for Three Game Kit.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takahirox/three-game-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collision": {
      "types": "./dist/collision.d.ts",
      "import": "./dist/collision.js"
    },
    "./authoritative": {
      "types": "./dist/authoritative.d.ts",
      "import": "./dist/authoritative.js"
    },
    "./networking": {
      "types": "./dist/networking.d.ts",
      "import": "./dist/networking.js"
    }
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@three-game-kit/core": "workspace:^",
    "@three-game-kit/protocol": "workspace:^",
    "@three-game-kit/shared": "workspace:^",
    "ws": "8.21.3"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1"
  }
}
