{
  "name": "@three-game-kit/client",
  "version": "0.1.0",
  "description": "Browser client runtime, rendering, input, camera, collision, assets, networking, and replication for Three Game Kit.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takahirox/three-game-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rendering": {
      "types": "./dist/rendering.d.ts",
      "import": "./dist/rendering.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./camera": {
      "types": "./dist/camera.d.ts",
      "import": "./dist/camera.js"
    },
    "./vfx": {
      "types": "./dist/vfx.d.ts",
      "import": "./dist/vfx.js"
    },
    "./collision": {
      "types": "./dist/collision.d.ts",
      "import": "./dist/collision.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./asset-manager": {
      "types": "./dist/asset-manager.d.ts",
      "import": "./dist/asset-manager.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./animation": {
      "types": "./dist/animation.d.ts",
      "import": "./dist/animation.js"
    },
    "./character-controller": {
      "types": "./dist/character-controller.d.ts",
      "import": "./dist/character-controller.js"
    },
    "./gameplay": {
      "types": "./dist/gameplay.d.ts",
      "import": "./dist/gameplay.js"
    },
    "./genre": {
      "types": "./dist/genre.d.ts",
      "import": "./dist/genre.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./networking": {
      "types": "./dist/networking.d.ts",
      "import": "./dist/networking.js"
    },
    "./replication": {
      "types": "./dist/replication.d.ts",
      "import": "./dist/replication.js"
    }
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@three-game-kit/core": "workspace:^",
    "@three-game-kit/protocol": "workspace:^",
    "@three-game-kit/shared": "workspace:^",
    "three": "0.185.1"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/three": "0.185.4"
  }
}
