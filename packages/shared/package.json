{
  "name": "@three-game-kit/shared",
  "version": "0.1.0",
  "description": "Shared game logic and movement utilities for Three Game Kit.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takahirox/three-game-kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./movement": {
      "types": "./dist/movement.d.ts",
      "import": "./dist/movement.js"
    },
    "./gameplay": {
      "types": "./dist/gameplay.d.ts",
      "import": "./dist/gameplay.js"
    }
  },
  "dependencies": {
    "@three-game-kit/core": "workspace:^"
  },
  "engines": {
    "node": "24.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
